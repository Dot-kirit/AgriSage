# AgriSage — environment variables
#
# Copy this file to `.env` (which is gitignored) and fill in real values
# once the corresponding backend integration is connected. Vite only
# exposes variables prefixed with VITE_ to client-side code.
#
# None of these are read yet — the app currently runs entirely on mock
# data (see src/data/mockData.js) and the API stubs in
# src/context/AppContext.jsx. Wire them in there when ready.

# --- Firebase (auth, Firestore) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Gemini API (chatbot / crop disease diagnosis) ---
VITE_GEMINI_API_KEY=

# --- Weather API ---
VITE_WEATHER_API_KEY=
VITE_WEATHER_API_BASE_URL=

# --- Soil data API ---
VITE_SOIL_API_KEY=
VITE_SOIL_API_BASE_URL=

# --- Translation API (chatbot + report translation) ---
VITE_TRANSLATION_API_KEY=
